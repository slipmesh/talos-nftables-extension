# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make extension TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# Used only for the extension manifest's `compatibility.talos.version` field and the
# published image tag - like ../talos-router-extension, this repo has no kernel-module
# dependency on ../talos-kernel, so this doesn't need to match that repo's pin.
TALOS_VERSION=v1.13.8

# siderolabs/pkgs checkout used to build our own statically-linked nftables-pkg (see
# patches/pkgs/nftables-pkg/pkg.yaml). Reuses ../talos-kernel/versions.env's own
# UPSTREAM_PKGS_REF value - not coupled by any build dependency, just the same upstream
# snapshot for consistency. Bump freely; `make checkout-pkgs` just needs it to resolve.
UPSTREAM_PKGS_REF=f677246a73ed1353a1e0ec9e92f0027b2f759978

# siderolabs/extensions checkout used to package nftables-pkg's binary + our own `nftables`
# extension-service daemon into an actual Talos system extension via its own pkg.yaml/bldr
# pipeline. Reuses ../talos-router-extension/versions.env's own UPSTREAM_EXTENSIONS_REF
# value, same reasoning. Bump freely; `make checkout-extensions` just needs it to resolve.
UPSTREAM_EXTENSIONS_REF=30067720457851d26682a0bcf50165efac3059c0

# --- the things we actually package ------------------------------------------------
# netfilter.org's libmnl -> libnftnl -> nftables chain, built statically from source (see
# patches/pkgs/nftables-pkg/pkg.yaml for why - siderolabs/pkgs already builds these three,
# but dynamically linked, which this repo's extension (variant: scratch, no shared libs
# staged) can't use as-is). Pins mirror siderolabs/pkgs' own Pkgfile vars at the time this
# was written (`UPSTREAM_PKGS_REF` above's checkout, `grep -A2 _version build/pkgs/Pkgfile`);
# regenerate the hashes with `make hashes` after changing a version.
LIBMNL_VERSION=1.0.5
LIBMNL_SHA256=274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525
LIBMNL_SHA512=16fa48e74c9da7724a85c655dfb0abd8369392627934639d65de951543e1447ac3e048d231248f1ce8861443c2ef62654a85a81feeedbbffaf2e5744f6cf4c9f

LIBNFTNL_VERSION=1.3.1
LIBNFTNL_SHA256=607da28dba66fbdeccf8ef1395dded9077e8d19f2995f9a4d45a9c2f0bcffba8
LIBNFTNL_SHA512=a4e689b003cc2ae2ecf203335265f337d6de7a50af5410d649a567535c109d08ee9dbae9e8572b1af8c67f09ea27877ca059e04ed3b1c12183ef7b4185bdd10f

# Deliberately NOT the latest (1.1.5 as of writing) - nftables >= 1.1.3 changed the
# on-wire "userdata" format for set/map elements with comments, which a still-widely-
# deployed *older* nft (kube-proxy 1.36 ships one bundled in its own container image,
# shared netfilter namespace via hostNetwork) cannot parse and segfaults on during a full
# ruleset resync (kubernetes/kubernetes#136786) - fixed only in kube-proxy targeting
# Kubernetes 1.37 (kubernetes/kubernetes#140405 bumped its bundled nft to 1.0.6.1), not
# 1.36. 1.1.1 is the newest release confirmed to predate that userdata format change -
# see that issue's own maintainer-recommended workaround range (1.0.1-1.1.1). This repo's
# own ruleset never adds `comment` annotations to sets/maps either way (a second
# independent safeguard, not a substitute for the version pin - see nftables.rs).
NFTABLES_VERSION=1.1.1
NFTABLES_SHA256=6358830f3a64f31e39b0ad421d7dadcd240b72343ded48d8ef13b8faf204865a
NFTABLES_SHA512=676413d4adadffb15d52c1f8f6432636cab83a7bcda1a18d9f0e6b58819a2c027a49922588c02bd9ad386de930eaa697bfe74c0938b595bf1ee485bfa7cf2e50

# --- where the artifacts go -------------------------------------------------------
IMAGE=docker.io/ffaxl/talos
