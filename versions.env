# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make extension TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# Used only for the extension manifest's `compatibility.talos.version` field and the
# published image tag - like ../talos-router-extension, this repo has no kernel-module
# dependency on ../talos-kernel, so this doesn't need to match that repo's pin.
TALOS_VERSION=v1.14.4

# siderolabs/pkgs checkout used to build our own statically-linked nftables-pkg (see
# patches/pkgs/nftables-pkg/pkg.yaml). Only the build environment comes from here;
# libmnl/libnftnl/nftables are fetched from netfilter.org by the versions below. No kernel
# module, so no vermagic to match - this is free to lag ../talos-kernel's own pin, and has.
#
# The `git describe` string Talos publishes, upstream's notation for this pin; see
# ../talos-kernel/versions.env.
PKGS=v1.14.0-44-g2ec10eb

# siderolabs/extensions checkout used to package nftables-pkg's binary + our own `nftables`
# extension-service daemon into an actual Talos system extension via its own pkg.yaml/bldr
# pipeline. A release tag, unlike the pkgs pin above: upstream tags extensions once per
# Talos version, so this names the Talos release the packaging came from. Derived rather
# than repeated: the two must agree, and a second literal is a second thing to forget.
UPSTREAM_EXTENSIONS_REF=${TALOS_VERSION}

# --- the things we actually package ------------------------------------------------
# netfilter.org's libmnl -> libnftnl -> nftables chain, built statically from source (see
# patches/pkgs/nftables-pkg/pkg.yaml for why - siderolabs/pkgs already builds these three,
# but dynamically linked, which this repo's extension (variant: scratch, no shared libs
# staged) can't use as-is). Each is upstream's latest stable release, independent of the
# versions siderolabs/pkgs builds; regenerate the hashes with `make hashes` after changing a
# version.
LIBMNL_VERSION=1.0.5
LIBMNL_SHA256=274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525
LIBMNL_SHA512=16fa48e74c9da7724a85c655dfb0abd8369392627934639d65de951543e1447ac3e048d231248f1ce8861443c2ef62654a85a81feeedbbffaf2e5744f6cf4c9f

LIBNFTNL_VERSION=1.3.2
LIBNFTNL_SHA256=c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0
LIBNFTNL_SHA512=ee60231f25c51ce45a8117e5a255265964ed024184c6b5ff4a883e6bbab6b0a66a73b6ca31be1c7055d778c5e7d780f483437eb9d27028dd9fcb6cc69af676ca

# Was held at 1.1.1 (predating the >= 1.1.3 on-wire "userdata" format change for set/map
# elements with comments) because kube-proxy 1.36's bundled nft couldn't parse it and
# segfaulted on a full ruleset resync (kubernetes/kubernetes#136786). Confirmed fixed:
# kubernetes/kubernetes#140405 bumped kube-proxy's bundled nft to 1.0.6.1, merged to
# release-1.36 2026-07-15 (commit 2c14a99), an ancestor of the v1.36.3 tag (published
# 2026-07-23) - so any Kubernetes >= 1.36.3 tolerates a current nft.
#
# This repo's own ruleset still never adds `comment` annotations to sets/maps either way (a
# second independent safeguard, not a substitute for the version check above - see
# nftables.rs).
NFTABLES_VERSION=1.1.7
NFTABLES_SHA256=a6fbf060d8d4fff001517a2b94f356bb4366bfbf0ba366366f9d27cc38caa58f
NFTABLES_SHA512=4dc900ad6e74c4ce532df974287bd3d5382ccabcee9e61b7639071abae70c215a8dea04d1f5af6f0f431e5717bd98db12dc858b00b51f284a17b488ef648b73d

# nft links musl statically from the tools image PKGS selects, and musl's MIT license asks for
# its notice to travel with the binary. This tarball is fetched for that COPYRIGHT file only, so
# it has to name the musl that image carries; nftables-pkg's test fails when the two differ.
# Same release and hashes as siderolabs/toolchain's Pkgfile.
MUSL_VERSION=1.2.6
MUSL_SHA256=d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a
MUSL_SHA512=1adad96eddb3a2eb0cacb3e363b0046568925fcdd75cf8b0503f2139df1f693d64730779ca0ce8131b7624ab2d37f4247bb1d3393c523de6e30d2b1d7732555c

# --- the daemon that ships inside the extension --------------------------------------
# slipmesh/talos-extensions release tag holding the daemon and its extension-services
# manifest. `make check-daemons` refuses to build unless the sibling checkout sits at it;
# DAEMONS_SHA (Makefile) only records what was used, it never constrained it.
DAEMONS_REF=v0.4.0

# --- where the artifacts go -------------------------------------------------------
IMAGE=ghcr.io/slipmesh/talos-nftables-extension
